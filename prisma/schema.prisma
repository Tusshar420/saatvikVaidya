// Saatvik Vaidya database schema.
// The connection URL lives in prisma.config.ts, read from DATABASE_URL.
//
// Sections, in order: users and access, admin, site settings, homepage
// content, learning, catalogue, cart and orders. Later phases add their own
// section (coins, ebooks...).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Users and access ───────────────────────────────────────────────────────
// User, Session, Account and Verification are Better Auth's tables (see
// src/server/auth/). Column names must match what Better Auth expects; the
// extra User fields are declared in src/server/auth/user-fields.ts too.

/// A kind of account, chosen at sign-up. Stored as data so admins can add
/// types later. Admin is a role on User, not a user type.
model UserType {
  id                   Int      @id @default(autoincrement())
  /// Stable identifier used in code and the seed, e.g. "customer", "doctor".
  key                  String   @unique @db.VarChar(40)
  label                String   @db.VarChar(80)
  /// Professional types get professional prices once verified.
  isProfessional       Boolean  @default(false)
  /// Needs documents approved by an admin before professional prices apply.
  requiresVerification Boolean  @default(false)
  /// Also gets products' bulk price tiers once professional prices apply
  /// (Pharmacy / Store and Stockist / Distributor). See src/server/pricing.
  bulkPricing          Boolean  @default(false)
  sortOrder            Int      @default(0)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  users                User[]
}

/// `admin` is only ever set by `pnpm admin:create` or directly in the
/// database, never from sign-up or profile input.
enum UserRole {
  user
  admin
}

/// Professional document checks. `none` for types that need no check.
enum VerificationStatus {
  none
  pending
  approved
  rejected
}

model User {
  id                      String                 @id @db.VarChar(64)
  name                    String                 @db.VarChar(191)
  /// Better Auth requires an email. Accounts created by phone OTP get a
  /// placeholder on the reserved ".invalid" domain (see
  /// src/server/auth/placeholder-email.ts), which is never shown or mailed.
  email                   String                 @unique @db.VarChar(191)
  emailVerified           Boolean                @default(false)
  image                   String?                @db.Text
  /// E.164, Indian mobiles only: "+91XXXXXXXXXX".
  phoneNumber             String?                @unique @db.VarChar(20)
  phoneNumberVerified     Boolean                @default(false)
  userTypeId              Int
  userType                UserType               @relation(fields: [userTypeId], references: [id], onDelete: Restrict)
  role                    UserRole               @default(user)
  verificationStatus      VerificationStatus     @default(none)
  /// When the professional last completed their set of required documents
  /// (see src/lib/verification.ts). Null until every required document is
  /// uploaded; shown as "submitted" on /account and in admin approvals.
  verificationSubmittedAt DateTime?
  marketingOptIn          Boolean                @default(false)
  /// When the user accepted the terms at sign-up (set by the server).
  termsAcceptedAt         DateTime
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  sessions                Session[]
  accounts                Account[]
  adminLogs               AdminLog[]
  documents               ProfessionalDocument[]
  /// Decisions about this user's verification.
  verificationComments    VerificationComment[]  @relation("VerificationSubject")
  /// Decisions this admin made about other users' verification.
  verificationDecisions   VerificationComment[]  @relation("VerificationAuthor")
  cart                    Cart?
  addresses               Address[]
  orders                  Order[]

  @@index([userTypeId])
}

model Session {
  id        String   @id @db.VarChar(64)
  expiresAt DateTime
  token     String   @unique @db.VarChar(191)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  userId    String   @db.VarChar(64)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A way to sign in. Email + password and phone-set passwords are
/// providerId "credential" with the password hash here.
model Account {
  id                    String    @id @db.VarChar(64)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(64)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Short-lived values: phone OTPs ("code:attempts", keyed by phone number)
/// and password-reset tokens.
model Verification {
  id         String   @id @db.VarChar(64)
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Fixed-window counters for the auth rate limits in
/// src/server/auth/rate-limit.ts, e.g. key "otp-send:phone:+919876543210".
/// Kept in the database so limits survive restarts.
model AuthRateLimit {
  key       String @id @db.VarChar(191)
  count     Int
  /// When the current window ends, in epoch milliseconds (timezone-free).
  resetAtMs BigInt

  @@index([resetAtMs])
}

// ─── Admin ──────────────────────────────────────────────────────────────────

/// Audit trail: one row per change made in the admin panel, written in the
/// same transaction as the change (src/server/admin/audit.ts). Never holds
/// secrets such as passwords or tokens.
model AdminLog {
  id         Int      @id @default(autoincrement())
  /// The admin who made the change; null once that account is deleted.
  userId     String?  @db.VarChar(64)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// What was done, e.g. "user.approve", "reel.update".
  action     String   @db.VarChar(40)
  /// Model name of what was changed, e.g. "User", "Reel".
  resource   String   @db.VarChar(40)
  /// Id of the changed row (kept after the row is deleted).
  resourceId String?  @db.VarChar(64)
  /// Changed fields as { field: { from, to } }, plus a note where given.
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([userId])
}

// ─── Professional verification ──────────────────────────────────────────────
// Professionals upload documents from /account; admins review them at
// /admin/approvals/detail/[userId]. Files live in Storage (src/server/storage)
// and are only served through /api/documents/[id], to their owner or an admin.

/// One uploaded document. A user has at most one current file per document
/// type; uploading again replaces it (and the old file is deleted).
model ProfessionalDocument {
  id           Int       @id @default(autoincrement())
  userId       String    @db.VarChar(64)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Key from src/lib/verification.ts, e.g. "drug_licence".
  documentType String    @db.VarChar(40)
  /// The file's key in Storage. Not a URL: files are never public.
  fileKey      String    @unique @db.VarChar(191)
  /// The name the file had on the user's device (cleaned), for display.
  fileName     String    @db.VarChar(191)
  /// Checked from the file's contents on upload, not taken from the browser.
  contentType  String    @db.VarChar(64)
  sizeBytes    Int
  uploadedAt   DateTime  @default(now())
  /// When an admin approved the account with this file on record.
  verifiedAt   DateTime?

  @@unique([userId, documentType])
}

enum VerificationDecision {
  approved
  rejected
}

/// An admin's approve or reject decision, with an optional comment. The
/// latest rejection's comment is shown to the professional as the reason.
model VerificationComment {
  id        Int                  @id @default(autoincrement())
  /// The professional the decision is about.
  userId    String               @db.VarChar(64)
  user      User                 @relation("VerificationSubject", fields: [userId], references: [id], onDelete: Cascade)
  /// The admin who decided; null once that account is deleted.
  authorId  String?              @db.VarChar(64)
  author    User?                @relation("VerificationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  decision  VerificationDecision
  comment   String?              @db.Text
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([authorId])
}

// ─── Site settings ──────────────────────────────────────────────────────────

/// One admin-editable site value (phone number, footer text, popular
/// searches...). Read through getSetting(), which validates the value and
/// falls back to the default in src/content/settings.ts.
model Setting {
  key       String           @id @db.VarChar(100)
  value     Json
  updatedAt DateTime         @updatedAt
  /// Id of the user who last changed it; null when set by the seed. Becomes a
  /// relation to User once A5 adds it.
  updatedBy String?
  history   SettingHistory[]
}

/// Every value a setting has had, newest last, including the seeded one.
model SettingHistory {
  id         Int      @id @default(autoincrement())
  settingKey String   @db.VarChar(100)
  setting    Setting  @relation(fields: [settingKey], references: [key], onDelete: Cascade)
  value      Json
  changedAt  DateTime @default(now())
  /// Id of the user who made the change; null for the seed.
  changedBy  String?

  @@index([settingKey, changedAt])
}

// ─── Homepage content ───────────────────────────────────────────────────────
// Read through getHomeContent() in src/server/content/home.ts.
//
// Conventions:
// - `key` is a stable identifier used by the seed (upserts) and tests.
// - `sortOrder` ascending, then id. Only `active` items are shown.
// - Link targets (`*Href`) are a site path ("/coins", "/#launch"), or
//   "modal:sign-in" / "modal:track-order" to open a site modal. Null means the
//   destination isn't built yet, so the UI shows a "coming soon" state.
// - Decorative glyphs (→ arrows, ✓ ticks, ▶ play) aren't stored; components
//   draw them.

/// Which homepage sections show, in what order, and their heading copy.
/// Section-specific extra copy (steps, panels...) is in `content`, validated
/// per section by src/server/content/home-schema.ts.
model HomeSection {
  key           String   @id @db.VarChar(40)
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  eyebrow       String?  @db.VarChar(80)
  title         String?  @db.VarChar(160)
  /// Second line of a two-part title, shown in teal.
  titleEmphasis String?  @db.VarChar(160)
  description   String?  @db.VarChar(400)
  linkLabel     String?  @db.VarChar(80)
  linkHref      String?  @db.VarChar(200)
  content       Json?
  updatedAt     DateTime @updatedAt
}

enum Tone {
  ORANGE
  TEAL
  BLUE
  GOLD
  NAVY
  GREEN
}

enum HeroPanelKind {
  LAUNCH_STUDIO
  BRAND_SHOWCASE
  LEARNING_BOARD
}

/// One hero carousel slide: copy on the left, a panel on the right.
model HeroSlide {
  id             Int           @id @default(autoincrement())
  key            String        @unique @db.VarChar(64)
  sortOrder      Int           @default(0)
  active         Boolean       @default(true)
  eyebrow        String        @db.VarChar(80)
  title          String        @db.VarChar(160)
  titleEmphasis  String?       @db.VarChar(160)
  body           String        @db.VarChar(400)
  primaryLabel   String        @db.VarChar(80)
  primaryHref    String?       @db.VarChar(200)
  secondaryLabel String?       @db.VarChar(80)
  secondaryHref  String?       @db.VarChar(200)
  /// Optional social-proof row under the buttons.
  proof          Json?
  panelKind      HeroPanelKind
  /// Copy for the right-hand panel; its shape depends on panelKind.
  panel          Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// Trust strip figure, e.g. "150+" / "Classical formulations".
model StatItem {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  value     String   @db.VarChar(40)
  label     String   @db.VarChar(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Reel filter group.
enum ReelType {
  PRODUCT
  FEEDBACK
  LEARNING
  OFFER
}

enum ReelMediaKind {
  VIDEO
  IMAGE
  /// No media file: a designed poster built from the poster* fields.
  POSTER
}

model Reel {
  id           Int           @id @default(autoincrement())
  key          String        @unique @db.VarChar(64)
  sortOrder    Int           @default(0)
  active       Boolean       @default(true)
  type         ReelType
  mediaKind    ReelMediaKind
  /// Path under public/, e.g. "/media/brand-launch.mp4".
  mediaSrc     String?       @db.VarChar(200)
  /// Poster frame for a video (path under public/).
  posterSrc    String?       @db.VarChar(200)
  /// Image alt text, or the play button's label for a video.
  mediaLabel   String?       @db.VarChar(200)
  badge        String?       @db.VarChar(60)
  badgeTone    Tone?
  /// Small corner chip: duration, source or time.
  metaLabel    String?       @db.VarChar(60)
  /// Highlighted value over the media, e.g. "1,000 Coins = ₹100".
  valueLabel   String?       @db.VarChar(60)
  posterKicker String?       @db.VarChar(80)
  /// Poster headline; may contain line breaks.
  posterText   String?       @db.VarChar(200)
  posterByline String?       @db.VarChar(80)
  title        String        @db.VarChar(200)
  linkLabel    String        @db.VarChar(80)
  linkHref     String?       @db.VarChar(200)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Offer {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  tone      Tone
  iconText  String   @db.VarChar(8)
  eyebrow   String   @db.VarChar(80)
  title     String   @db.VarChar(160)
  body      String   @db.VarChar(300)
  /// Accessible name of the card's arrow link.
  linkLabel String   @db.VarChar(80)
  linkHref  String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// "Start here" tiles.
model QuickAction {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(64)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  tone        Tone
  iconText    String   @db.VarChar(8)
  title       String   @db.VarChar(80)
  description String   @db.VarChar(160)
  href        String?  @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CategoryKind {
  FORM
  PRACTICE_AREA
}

/// Catalogue entry point: a product form (Vati, Churna...) or a practice area.
model Category {
  id        Int          @id @default(autoincrement())
  /// Also the future URL slug.
  key       String       @unique @db.VarChar(64)
  kind      CategoryKind
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  name      String       @db.VarChar(80)
  /// Short Devanagari mark shown on the tile, e.g. "चू".
  glyph     String?      @db.VarChar(8)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  /// Products of this form (kind FORM only).
  formProducts Product[] @relation("ProductForm")
  /// Products in this practice area (kind PRACTICE_AREA only).
  areaProducts Product[] @relation("ProductPracticeAreas")
}

model Brand {
  id          Int      @id @default(autoincrement())
  /// Also the future URL slug.
  key         String   @unique @db.VarChar(64)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  name        String   @db.VarChar(80)
  monogram    String   @db.VarChar(4)
  /// Logo image (path under public/). Uploads come with R2 later.
  logoSrc     String?  @db.VarChar(200)
  tone        Tone
  eyebrow     String   @db.VarChar(80)
  description String   @db.VarChar(300)
  linkLabel   String   @db.VarChar(80)
  /// Null links to this brand's products in the catalogue.
  linkHref    String?  @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
}

model CourseTeaser {
  id         Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(64)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  tag        String   @db.VarChar(60)
  title      String   @db.VarChar(160)
  body       String   @db.VarChar(300)
  metaLabel  String   @db.VarChar(40)
  metaValue  String   @db.VarChar(80)
  /// For the admin list and the future course page (Phase 3).
  instructor String?  @db.VarChar(80)
  /// Display text, e.g. "3 days" or "6 hours".
  duration   String?  @db.VarChar(40)
  /// YouTube video or embed URL (courses are YouTube-based).
  videoUrl   String?  @db.VarChar(300)
  linkLabel  String   @db.VarChar(80)
  linkHref   String?  @db.VarChar(200)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Saatvik Live session teaser.
model LiveSession {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  tag       String   @db.VarChar(60)
  title     String   @db.VarChar(160)
  body      String   @db.VarChar(300)
  metaLabel String   @db.VarChar(40)
  /// Display text for when it runs, e.g. "Monday • 8 PM".
  metaValue String   @db.VarChar(80)
  linkLabel String   @db.VarChar(80)
  linkHref  String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Verified testimonial with a photo of the original (letterhead, note...).
model Feedback {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  /// Shown large in the homepage feedback section.
  featured  Boolean  @default(false)
  imageSrc  String   @db.VarChar(200)
  imageAlt  String   @db.VarChar(200)
  badge     String   @db.VarChar(60)
  quote     String   @db.VarChar(600)
  caption   String   @db.VarChar(160)
  linkLabel String   @db.VarChar(80)
  linkHref  String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// "Why Saatvik" step. Its number comes from the order.
model WhyStep {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  title     String   @db.VarChar(80)
  body      String   @db.VarChar(300)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Learning ───────────────────────────────────────────────────────────────
// Managed in the admin panel. Quiz & Win itself (attempts, coins,
// leaderboards) is Phase 2; until then quizzes are only authored.

model Quiz {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(160)
  description String?        @db.VarChar(600)
  /// Finished and ready to publish once Quiz & Win launches.
  active      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  questions   QuizQuestion[]
}

model QuizQuestion {
  id        Int          @id @default(autoincrement())
  quizId    Int
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)
  prompt    String       @db.VarChar(400)
  points    Int          @default(10)
  options   QuizOption[]

  @@index([quizId, sortOrder])
}

/// An answer choice. Exactly one per question is correct.
model QuizOption {
  id         Int          @id @default(autoincrement())
  questionId Int
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder  Int          @default(0)
  text       String       @db.VarChar(200)
  isCorrect  Boolean      @default(false)

  @@index([questionId, sortOrder])
}

// ─── Catalogue ──────────────────────────────────────────────────────────────
// Managed at /admin/catalogue; shown at /products, /products/[slug] and
// /search. Money is in paise (integers). Which price a viewer gets is decided
// only by src/server/pricing; pages never read professional or bulk prices
// themselves.

model Product {
  id                     Int             @id @default(autoincrement())
  /// URL segment: /products/<slug>. Lowercase words joined by dashes.
  slug                   String          @unique @db.VarChar(120)
  name                   String          @db.VarChar(160)
  /// Null only if the brand was deleted; the admin form requires one.
  brandId                Int?
  brand                  Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// The product's form (a Category of kind FORM), e.g. Churna.
  formId                 Int
  form                   Category        @relation("ProductForm", fields: [formId], references: [id], onDelete: Restrict)
  /// Practice areas (Categories of kind PRACTICE_AREA).
  practiceAreas          Category[]      @relation("ProductPracticeAreas")
  /// Plain text; line breaks are kept when shown.
  description            String          @db.Text
  ingredients            String?         @db.Text
  dosage                 String?         @db.Text
  /// Display text, e.g. "60 tablets" or "200 ml".
  packSize               String          @db.VarChar(60)
  /// Retail price (MRP), including GST, in paise.
  mrpPaise               Int
  /// Price for approved professionals, including GST, in paise. At most MRP.
  professionalPricePaise Int
  /// GST percentage included in the prices, e.g. 5 or 12.
  gstRate                Int
  /// HSN code for GST invoices (4, 6 or 8 digits).
  hsnCode                String          @db.VarChar(8)
  /// Units in stock. Checkout (P1.4) reduces it.
  stock                  Int             @default(0)
  /// Minimum order quantity.
  moq                    Int             @default(1)
  active                 Boolean         @default(true)
  featured               Boolean         @default(false)
  sortOrder              Int             @default(0)
  /// Seeded example, not a real product: the site labels it "Sample".
  isSample               Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  images                 ProductImage[]
  bulkTiers              BulkPriceTier[]
  cartItems              CartItem[]
  orderItems             OrderItem[]

  @@index([active, sortOrder])
  @@index([brandId])
  @@index([formId])
}

/// A product photo, stored in Storage (src/server/storage) and served by
/// /api/product-images/[id]. The first by sortOrder is the main image.
model ProductImage {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The file's key in Storage, e.g. "products/12/<random>.jpg".
  fileKey     String   @unique @db.VarChar(191)
  /// Checked from the file's contents on upload.
  contentType String   @db.VarChar(64)
  sizeBytes   Int
  alt         String   @db.VarChar(200)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([productId, sortOrder])
}

/// A lower unit price from a quantity upwards, for user types with
/// bulkPricing once approved. Prices fall as quantities rise.
model BulkPriceTier {
  id          Int     @id @default(autoincrement())
  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity Int
  /// Unit price, including GST, in paise.
  pricePaise  Int

  @@unique([productId, minQuantity])
}

// ─── Cart and orders ────────────────────────────────────────────────────────
// /cart, /checkout and the payment screens (P1.4). Code is in src/server/cart,
// src/server/checkout and src/server/payments. Prices are never stored on a
// cart: every view and every checkout step prices the lines again with
// priceFor(). An order keeps a snapshot of what was charged.

/// A shopping cart: a signed-in user's (one each), or a guest's, found by
/// the hash of the random token in the guest's "sv.cart" cookie. A guest
/// cart is merged into the user's cart when they sign in.
model Cart {
  id             Int        @id @default(autoincrement())
  userId         String?    @unique @db.VarChar(64)
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) of the guest cookie's token; null for a user's cart. The
  /// token itself is never stored.
  guestTokenHash String?    @unique @db.Char(64)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  items          CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

/// A saved delivery address. Orders copy it, so editing an address never
/// changes a placed order.
model Address {
  id         Int       @id @default(autoincrement())
  userId     String    @db.VarChar(64)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Who receives the parcel.
  name       String    @db.VarChar(100)
  /// E.164, Indian mobiles only: "+91XXXXXXXXXX".
  phone      String    @db.VarChar(20)
  /// House or flat number, building.
  line1      String    @db.VarChar(200)
  /// Street, area or locality.
  line2      String?   @db.VarChar(200)
  landmark   String?   @db.VarChar(120)
  city       String    @db.VarChar(100)
  /// State or union territory code from src/lib/india.ts, e.g. "MH".
  state      String    @db.VarChar(4)
  /// Six-digit PIN code.
  pincode    String    @db.Char(6)
  /// Last used for an order; the most recent one is picked at checkout.
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, lastUsedAt])
}

enum OrderStatus {
  pending_payment
  paid
  payment_failed
  cancelled
  processing
  shipped
  delivered
}

/// An order. Prices, tax and the delivery address are copied in when it is
/// placed and never recomputed afterwards.
model Order {
  id            String      @id @db.VarChar(32)
  /// Shown to the customer, e.g. "SV-7K2Q9F4M".
  number        String      @unique @db.VarChar(20)
  /// Null only if the account was deleted; the order is kept for records.
  userId        String?     @db.VarChar(64)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Random key from the checkout page, so a double submit places one order.
  checkoutKey   String      @db.VarChar(36)
  status        OrderStatus @default(pending_payment)
  shipName      String      @db.VarChar(100)
  shipPhone     String      @db.VarChar(20)
  shipLine1     String      @db.VarChar(200)
  shipLine2     String?     @db.VarChar(200)
  shipLandmark  String?     @db.VarChar(120)
  shipCity      String      @db.VarChar(100)
  shipState     String      @db.VarChar(4)
  shipPincode   String      @db.Char(6)
  /// Sum of the line totals (prices include GST), in paise.
  subtotalPaise Int
  /// GST included in the subtotal, in paise.
  taxPaise      Int
  shippingPaise Int
  totalPaise    Int
  /// When payment succeeded and stock was taken.
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  payments      Payment[]

  @@unique([userId, checkoutKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// One line of an order, with the product as it was when ordered.
model OrderItem {
  id             Int      @id @default(autoincrement())
  orderId        String   @db.VarChar(32)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Null if the product was deleted later; the snapshot below stays.
  productId      Int?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSlug    String   @db.VarChar(120)
  productName    String   @db.VarChar(160)
  packSize       String   @db.VarChar(60)
  hsnCode        String   @db.VarChar(8)
  /// GST percentage included in the price.
  gstRate        Int
  mrpPaise       Int
  /// What one unit cost this buyer, including GST.
  unitPaise      Int
  /// "mrp", "professional" or "bulk" (src/server/pricing).
  priceTier      String   @db.VarChar(16)
  quantity       Int
  /// unitPaise × quantity.
  lineTotalPaise Int
  /// GST included in the line total.
  taxPaise       Int

  @@index([orderId])
  @@index([productId])
}

enum PaymentStatus {
  created
  succeeded
  failed
}

/// One attempt to pay for an order. A failed attempt stays; "Try again"
/// starts the next attempt on the same order.
model Payment {
  id            Int           @id @default(autoincrement())
  orderId       String        @db.VarChar(32)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// PAYMENT_PROVIDER that handled it, e.g. "test" (Razorpay later).
  provider      String        @db.VarChar(20)
  /// The provider's id for this attempt.
  reference     String        @unique @db.VarChar(64)
  amountPaise   Int
  status        PaymentStatus @default(created)
  /// 1 for the first attempt on the order, then 2, 3...
  attempt       Int
  /// Why it failed, e.g. "declined" or "out_of_stock".
  failureReason String?       @db.VarChar(40)
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([orderId, attempt])
}
