# Copy to .env.local and fill in local values. Never commit real secrets.
# Every variable the app reads must be listed here.

# Local MySQL (Homebrew). root has no password on the dev machine.
# On a server each address has its own database. The start-up check
# (src/server/site-check.ts) needs the test address's database name to
# contain "test" or "staging" and the live site's name not to.
DATABASE_URL="mysql://root@localhost:3306/saatvik_vaidya"

# Used by `pnpm test` and `pnpm db:test:prepare`. Must end in "_test".
TEST_DATABASE_URL="mysql://root@localhost:3306/saatvik_vaidya_test"

# Folder for uploaded files (professional documents; later product images and
# ebooks). Must be outside public/: files are only served through authorised
# routes. Relative paths are from the app folder. Git-ignored.
STORAGE_DIR="storage"

# Shows the /design component showcase outside `pnpm dev` (read at request
# time). Leave "false" in production.
SHOW_DESIGN_PAGE="false"

# Better Auth. The secret signs sessions and tokens: at least 32 random
# characters, e.g. `openssl rand -base64 32`. Never reuse the example value.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# The site's own origin (used for links and the CSRF origin check). Required
# on a server, with https://; the site will not start without it.
BETTER_AUTH_URL="http://localhost:3000"

# Dev only: with "true" (and NODE_ENV not production), the latest OTP for a
# phone is exposed to the UI at /api/dev/otp. Always "false" in production.
DEV_SHOW_OTP="false"

# Used only by `pnpm admin:create` to create or update the admin account.
# ADMIN_PASSWORD: at least 12 characters and not a common password.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin"
ADMIN_NAME="Saatvik Vaidya Admin"

# Payments. "request" is the launch way until Razorpay: the customer places the
# order and sees no payment options; the team calls them to agree how to pay,
# and an admin marks the order paid. "manual" instead shows a UPI QR code and
# bank details (set in Admin > Settings) after the order. "test" is for development: a screen to
# simulate success or failure, no money moves; it refuses to run when
# NODE_ENV=production. Use "request" on the test address and the live site.
PAYMENT_PROVIDER="test"
# Lets the test provider run in a production build, but only when
# BETTER_AUTH_URL is localhost (Playwright's local build sets this). Never
# set it on a live site.
TEST_PAYMENTS_IN_LOCAL_BUILD="false"

# Shipping. Only "test" exists until Shiprocket is added: "Create shipment"
# gives a made-up courier and AWB number, and the admin simulates each
# delivery step. The test provider refuses to run when NODE_ENV=production.
SHIPPING_PROVIDER="test"
# Lets the test shipping provider run in a production build, but only when
# BETTER_AUTH_URL is localhost (Playwright's local build sets this). Never
# set it on a live site.
TEST_SHIPPING_IN_LOCAL_BUILD="false"

# Shown with each error in the admin Error log. Optional: unset, the git
# commit is used at build time (or "dev" when there is no git).
APP_VERSION=""

# Private test address only: with a password set, every page asks the team for
# a user name and password and search engines are told not to index it. Leave
# both empty on the live site. Only safe over https. The password is also how
# the start-up check tells the test address from the live site.
STAGING_ACCESS_USER="team"
STAGING_ACCESS_PASSWORD=""
